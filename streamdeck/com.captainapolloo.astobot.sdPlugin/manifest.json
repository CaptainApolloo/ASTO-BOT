{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.captainapolloo.astobot",
  "SDKVersion": 3,
  "Name": "ASTO-BOT",
  "Version": "1.1.0.0",
  "Author": "CaptainApolloo",
  "Description": "Control ASTO-BOT from your Stream Deck: run scripts, trigger events, control clips, queues, overlays, the browser overlay and photo mode. Scripts, events, overlays and queues are read live from ASTO-BOT, so you pick them from a list instead of typing names.",
  "Category": "ASTO-BOT",
  "CategoryIcon": "icons/category",
  "Icon": "icons/plugin",
  "URL": "https://www.twitch.tv/CaptainApolloo",
  "CodePath": "plugin.html",
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.captainapolloo.astobot.command",
      "Name": "Command",
      "Icon": "icons/command",
      "Tooltip": "Send any ASTO-BOT command — pick it from the list.",
      "PropertyInspectorPath": "pi/command.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "icons/command_key_off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/command_key",
          "TitleAlignment": "bottom"
        }
      ],
      "DisableAutomaticStates": true
    },
    {
      "UUID": "com.captainapolloo.astobot.script",
      "Name": "Run Script",
      "Icon": "icons/script",
      "Tooltip": "Run an ASTO-BOT script by name.",
      "PropertyInspectorPath": "pi/script.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "icons/script_key_off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/script_key",
          "TitleAlignment": "bottom"
        }
      ],
      "DisableAutomaticStates": true
    },
    {
      "UUID": "com.captainapolloo.astobot.event",
      "Name": "Trigger Event",
      "Icon": "icons/event",
      "Tooltip": "Trigger an ASTO-BOT event by its event/signal name.",
      "PropertyInspectorPath": "pi/event.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "icons/event_key_off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/event_key",
          "TitleAlignment": "bottom"
        }
      ],
      "DisableAutomaticStates": true
    },
    {
      "UUID": "com.captainapolloo.astobot.translator",
      "Name": "Translator",
      "Icon": "icons/translator",
      "Tooltip": "Turn the live translator on, off or toggle it.",
      "PropertyInspectorPath": "pi/translator.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "icons/translator_key_off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/translator_key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "UUID": "com.captainapolloo.astobot.chatoverlay",
      "Name": "Chat Overlay",
      "Icon": "icons/chat",
      "Tooltip": "Turn the chat overlay on, off or toggle it.",
      "PropertyInspectorPath": "pi/chatoverlay.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "icons/chat_key_off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/chat_key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "UUID": "com.captainapolloo.astobot.ptt",
      "Name": "Push to Talk",
      "Icon": "icons/ptt",
      "Tooltip": "Hold the key to talk — voice input runs while the key is held down.",
      "PropertyInspectorPath": "pi/ptt.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "icons/ptt_key_off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/ptt_key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "UUID": "com.captainapolloo.astobot.status",
      "Name": "Reconnect",
      "Icon": "icons/status",
      "Tooltip": "Reconnect to ASTO-BOT straight away. Lights up while ASTO-BOT is reachable.",
      "PropertyInspectorPath": "pi/status.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "icons/status_off_key",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/status_on_key",
          "TitleAlignment": "bottom"
        }
      ],
      "DisableAutomaticStates": true
    }
  ]
}
